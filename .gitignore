# This repo is scoped to the ECU project (firmware + PCB) only.
# Sibling project directories in this same workspace are real,
# independent projects (car-parts-shop has its own separate .git repo)
# and are deliberately excluded here, not just left untracked -
# this keeps a future `git add -A` from ever sweeping them in by accident.
/car-parts-shop/
/manifold-pcb/
/manifold-pcb.zip
/spica-rebuilding-services/
/thermo-pcb/
/.claude/

# --- ecu-pcb: generated/derived content, not source ---
# FreeRouting is a real, generic third-party autorouter tool (57MB jar),
# not project-specific code - documented as a real download requirement
# in ecu-pcb/README.md instead of committed.
ecu-pcb/tools/*.jar
# KiCad/editor working files and intermediate autorouter exports -
# regenerated by build_schematic.py/build_pcb.py/route_board.py, not
# hand-authored source.
ecu-pcb/.history/
ecu-pcb/__pycache__/
ecu-pcb/schematic_export/
ecu-pcb/*.dsn
ecu-pcb/*.ses
ecu-pcb/*-backups/
ecu-pcb/fp-info-cache
ecu-pcb/*.kicad_pcb-bak
ecu-pcb/*.kicad_sch-bak

# --- ecu-firmware: no local toolchain exists this session, but real
# build output patterns are excluded preemptively for whenever one is
# set up (S32 Design Studio / PowerPC-EABI). ---
ecu-firmware/build/
ecu-firmware/*.o
ecu-firmware/*.elf
ecu-firmware/*.bin
ecu-firmware/*.map

# --- generic ---
__pycache__/
*.pyc
.DS_Store
Thumbs.db
