		(at 30 1198 0)
		(effects
			(font
				(size 1.6 1.6)
			)
		)
		(uuid "fef887b1-3bfc-4b68-8532-63a4950f9675")
	)
	(text "      practice. 68k/10k puts full scale at ~25.7V so a 24V jump-start"
		(exclude_from_sim no)
		(at 30 1374 0)
		(effects
			(font
				(size 1.6 1.6)
			)
		)
		(uuid "ff3215fa-272f-40ba-8e9b-1f8f2b9d82fb")
	)
	(text "    of check that caught the real JTAG TDO pin_to_pin bug in step 3 -"
